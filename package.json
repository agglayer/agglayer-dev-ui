{
  "name": "agglayer-dev-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "build:production": "cp .env.production .env.local && rm -f .env.staging && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:config": "node ./scripts/validateConfig.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run validate:config && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@agglayer/sdk": "^1.0.0-beta.29",
    "@reown/appkit": "^1.8.15",
    "@reown/appkit-adapter-wagmi": "^1.8.15",
    "@tanstack/react-query": "^5.90.16",
    "@wagmi/core": "^2.22.1",
    "bignumber.js": "^9.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "viem": "^2.43.5",
    "wagmi": "^2.16.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@next/env": "^16.2.6",
    "@playwright/test": "^1.57.0",
    "@polygonlabs/apps-team-lint": "^2.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.0.0",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
