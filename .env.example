NEXT_PUBLIC_PROJECT_ID=YOUR_PROJECT_ID_HERE
# Optional: overrides config.json bridgeHubApiBaseUrl when set.
# NEXT_PUBLIC_BRIDGE_HUB_API=http://localhost:8080
# E2E only: this key is relayed to NEXT_PUBLIC_E2E_PRIVATE_KEY by Playwright.
# Never set NEXT_PUBLIC_E2E_PRIVATE_KEY directly in non-E2E app environments.
E2E_PRIVATE_KEY=0xYOUR_E2E_PRIVATE_KEY
NEXT_PUBLIC_E2E_ENABLED=false
NEXT_PUBLIC_E2E_WALLET_ADDRESS=0xYOUR_E2E_ADDRESS
